      },
      "users": {
        ".read": "auth != null && (root.child('staging').child('users').child(auth.uid).child('profile').child('role').val() === 'manager' || root.child('staging').child('users').child(auth.uid).child('profile').child('role').val() === 'owner')",
        "$uid": {
          "profile": {
