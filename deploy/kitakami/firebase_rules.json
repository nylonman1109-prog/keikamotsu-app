          "status": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'manager' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'owner') && $uid !== root.child('companyMeta').child('createdBy').val()"
          },
          "role": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'manager' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'owner') && $uid !== root.child('companyMeta').child('createdBy').val() && $uid !== auth.uid && (newData.val() === 'driver' || newData.val() === 'manager')"
          },
          "editUnlockUntil": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'manager' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'owner')"
          }
