            ".write": "auth != null && auth.uid === $uid && root.child('staging').child('users').child($uid).child('profile').child('status').val() === 'approved'"
          },
          "gyomu": {
            ".read": "auth != null && auth.uid === $uid && root.child('staging').child('users').child($uid).child('profile').child('status').val() === 'approved'",
            ".write": "auth != null && auth.uid === $uid && root.child('staging').child('users').child($uid).child('profile').child('status').val() === 'approved'"
          },
          "vehicleCheck": {
